{
  // Multiplayer server for 111k. Deployed by .github/workflows/worker.yml,
  // or by hand from this folder:  npx wrangler deploy
  // Lives at https://111k-room.meinong.workers.dev (client: src/config.js).
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "111k-room",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    // Sites allowed to connect (comma separated). Add the custom domain here when there is one.
    "ALLOWED_ORIGINS": "https://coldnightwarmth.github.io,https://111k-site.meinong.workers.dev,https://1-1-1k.online,https://www.1-1-1k.online",
    "ALLOW_LOCALHOST_ORIGINS": "true"
  },
  // a deploy reaches the running room within seconds (the default lets a busy room run old code
  // for up to 5 minutes); hibernated WebSockets stay connected across the switch
  "durable_objects": {"bindings": [{"name": "ROOM", "class_name": "Room"}],
    "code_update_strategy": {"mode": "deferred", "max_delay": 10}},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Room"]}]
}
