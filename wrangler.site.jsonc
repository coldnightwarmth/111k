// The site itself on Cloudflare (Workers static assets: the files tools/build_site.sh builds; site/worker.js only
// sees the pages, for the "soon" page until the launch (and /playtest, the game open for playtesters) and to keep
// /anim, /graffiti and /sfx off this copy, and
// /assets, to compress the .glb models),
// deployed by .github/workflows/site.yml. Served with brotli, HTTP/3 and the cache headers in _site/_headers,
// at https://111k-site.<account>.workers.dev and the custom domain once it's attached.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "111k-site",
  "main": "site/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/playtest*", "/anim*", "/graffiti*", "/sfx*", "/assets/cinema/*"]
  }
}
